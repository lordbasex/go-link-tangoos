[Unit]
Description=TangoOS server (desktop, signaling, WebRTC)
Documentation=https://github.com/lordbasex/go-link-tangoos
After=network-online.target tango-agent.socket
Wants=network-online.target tango-agent.socket

[Service]
Type=simple
User=tango
Group=tango
ExecStart=/usr/bin/tangod
Restart=on-failure
RestartSec=2

# State: /var/lib/tango (TLS certificate, later SQLite). systemd creates it
# owned by tango and exports STATE_DIRECTORY.
StateDirectory=tango
StateDirectoryMode=0750

# Only privilege: binding :80/:443. ICE (8443/udp+tcp) and STUN
# (3478/udp+tcp) are unprivileged ports.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Not PrivateDevices: the inventory reads the /dev/disk/by-id and by-path
# symlinks (stable disk names). DevicePolicy=closed still forbids opening
# any device node: raw disk access belongs to tango-agent.
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
